# =============================================
# GateLock Raspberry Pi - Configuración
# Copia este archivo a .env y ajusta los valores
# =============================================

# --- API Backend ---
# URL del backend (desde la Raspberry, debe ser accesible en la red)
# Local: http://localhost:5000/api
# Red local: http://192.168.0.12:5000/api
# Producción: https://api.tudominio.com/api
API_BASE_URL=http://localhost:5000/api
API_USERNAME=tu_email@ejemplo.com
API_PASSWORD=tu_contraseña

# Timeout para peticiones API (segundos). Subida de video usa timeout mayor
API_TIMEOUT_SECONDS=30

# --- Cámara ---
CAMERA_INDEX=0

# --- Reconocimiento ---
RECOGNITION_THRESHOLD=0.5
FACE_DETECTION_CONFIDENCE=0.5

# --- Video ---
CLIP_DURATION_SECONDS=10
VIDEO_OUTPUT_DIR=./videos
VIDEO_FPS=30

# --- Base de datos ---
KNOWN_FACES_DIR=./known_faces
DATABASE_DIR=./database

# --- Augmentación ---
AUG_PER_IMAGE=20
MAX_IMAGES_PER_ID=10

# Cooldown entre alertas (segundos). Evita enviar múltiples alertas seguidas.
ALERT_COOLDOWN_SECONDS=120
