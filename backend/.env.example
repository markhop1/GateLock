# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gatelock?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
# In development, any localhost origin is allowed automatically
# In production, specify allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Cloudflare R2 (optional - for production video storage)
# Without R2, videos are stored locally in uploads/videos
# Create bucket at Cloudflare Dashboard > R2 > Create bucket > Enable public access
# Create API token at R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public URL: r2.dev subdomain (https://pub-xxx.r2.dev) or custom domain
R2_PUBLIC_URL=

# Nuki Smart Lock (optional - leave empty to disable)
# Get token at https://developer.nuki.io - Get smartlock ID via GET https://api.nuki.io/smartlock
NUKI_TOKEN=
NUKI_SMARTLOCK_ID=
# Action: unlock (default) or unlatch - unlatch opens the latch for self-closing doors
NUKI_ACTION=unlock
