# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/gatelock?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
# In development, any localhost origin is allowed automatically
# In production, specify allowed origins separated by commas
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Nuki Smart Lock (optional - leave empty to disable)
# Get token at https://developer.nuki.io - Get smartlock ID via GET https://api.nuki.io/smartlock
NUKI_TOKEN=
NUKI_SMARTLOCK_ID=
# Action: unlock (default) or unlatch - unlatch opens the latch for self-closing doors
NUKI_ACTION=unlock
